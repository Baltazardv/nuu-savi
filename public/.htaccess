# Ñuu Savi — SPA fallback para Apache/cPanel.
# Sirve index.html en rutas del enrutador (react-router) para que
# recargar /transparencia, /cabildo, etc. no dé 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # No reescribir archivos ni carpetas reales (assets, pdf, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Todo lo demás va al index.html de la app
  RewriteRule ^ index.html [L]
</IfModule>

# Cache de assets estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
